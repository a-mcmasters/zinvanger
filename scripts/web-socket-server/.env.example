# Generated by scripts/sync-project-config.ts. Copy to .env to configure the proxy.

# Address that the proxy will listen on. The default only accepts connections from this computer.
# 0.0.0.0 lets any device on your network send AnkiConnect actions (including deleting decks) through the proxy.
HOST=127.0.0.1

# Port that the proxy will listen on
PORT=8766

# AnkiConnect URL
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Action for asbplayer to take when the proxy receives an addNote request
# 0 = 'None'
# 1 = 'Open Anki dialog'
# 2 = 'Update last card' (updates last card with asbplayer media AFTER passing through original addNote request)
# 3 = 'Export card'
POST_MINE_ACTION=2

# Extra comma-separated origins allowed to connect to the WebSocket, e.g. a self-hosted or dev (http://localhost:3000) web app.
# Browser extensions and https://a-mcmasters.github.io are always allowed.
ALLOWED_ORIGINS=
